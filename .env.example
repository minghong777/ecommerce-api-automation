# EXAMPLE ONLY. Not loaded automatically. Copy OUTSIDE the repository, chmod 600,
# edit locally, then `set -a; source /protected/path/job.env; set +a`.
# Use exactly ONE credential source. Never paste credential JSON into chat.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/protected/path/service-account.json
# Alternative to the file variable above (do not configure both):
# GOOGLE_SERVICE_ACCOUNT_JSON='<full service-account JSON from a secret store>'
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
GOOGLE_SHEETS_SUMMARY_SHEET=CommerceFlow_Summary
GOOGLE_SHEETS_ORDERS_SHEET=CommerceFlow_Orders
GOOGLE_SHEETS_PRODUCTS_SHEET=CommerceFlow_TopProducts
